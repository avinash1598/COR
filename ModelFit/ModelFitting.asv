close all
clear all

%% Load data
data = load('COR15.mat');
stimOri = data.dat.stimOri;
reportedOri = data.dat.reportedOri;

absErr = abs(stimOri - reportedOri);
absOriError = min(absErr, 180 - absErr);  % ensures error is in [0, 90]
rawError = stimOri - reportedOri;
rawOriError = mod(rawError + 90, 180) - 90;

data.dat.absOriError = absOriError;
data.dat.rawOriError = rawOriError;

%% Energy landscape
clear all
% close all

modelData = load('modelContOriData.mat');
grpOriErr = modelData.data.err; 

sigma_e = linspace(5, 20, 100);
sigma_i = linspace(5, 20, 100);
varGain = 0.5;

E = zeros(numel(sigma_e), numel(sigma_i));

for i = 1:numel(sigma_e)
    for j = 1:numel(sigma_i)

        sigma_e_ = sigma_e(i);
        sigma_i_ = sigma_i(j);
        x = grpOriErr(1, :);
        p = myCustomPDF(x, sigma_e_, sigma_i_, varGain);
        p(p <= 0 | isnan(p)) = eps;
        ll = sum(log(p)); % negative log likelihood
        
        E(i, j) = -ll;
    end
end

% Plot 3D surface
figure;
surf(sigma_i, sigma_e, E);
xlabel('\sigma_{i}');
ylabel('\sigma_{ext}');
zlabel('Negative Log-Likelihood');
title(['Energy landscape at \varGain = ', num2str(varGain)]);
shading interp;
colorbar;

%% MLE estimation - log likelihood with std devation constraint
% close all
clear all

modelData = load('modelContOriData.mat');
grpOriErr = modelData.data.err; %(1, :);
dataPts = -90:3:90;

nonlcon = @(x) var_constraint(x, grpOriErr);

% Genetic algorithm
nParams = size(grpOriErr, 1) + 2;   % sigma_e (per row), sigma_i, gain

% Objective function
objFun = @(x) minimizeError(x, grpOriErr);

% Bounds (ga requires finite bounds!)
lb = [zeros(1, size(grpOriErr, 1)), 0, 0];     % same as before
ub = []; % example finite upper bounds

% GA options
options = optimoptions('ga', ...
    'Display','iter', ...
    'UseParallel',false, ...     % turn on parallel if you have Parallel Toolbox
    'PopulationSize',2000, ...
    'MaxGenerations',5000);

% Run GA
[optimalValues, fval] = ga(objFun, nParams, [], [], [], [], lb, ub, [], options);

disp('Optimal parameters:');
disp(optimalValues);
disp('Final objective value:');
disp(fval);

% % Modify with fminconn
% nParams = size(grpOriErr, 1) + 1;   % sigma_e (per row), sigma_i, gain
% 
% % Nonlinear constraint
% nonlcon = @(x) var_constraint(x, grpOriErr);
% 
% % Optimization problem definition
% x0 = [rand(1, size(grpOriErr, 1)), rand];
% lb = [zeros(1, size(grpOriErr, 1)), 0];
% ub = [];
% options = optimset('Display', 'iter', 'TolFun', 1e-6, 'TolX', 1e-6); %1e-6
% optimalValues = fmincon(@(x) minimizeError(x, grpOriErr), ...
%     x0, [], [], [], [], lb, ub, nonlcon, options);
% 
% disp('Optimal parameters:');
% disp(optimalValues);


nLevels = size(grpOriErr, 1);
sigma_e_arr = optimalValues(1:nLevels);
sigma_i = optimalValues(nLevels + 1);
scale = optimalValues(nLevels + 2); %0.5;
shape = 1/scale; 
analyticalStd = sqrt(sigma_e_arr.^2 + sigma_i^2*scale^2*shape*(shape+1));
disp(analyticalStd)


% % Global search
% problem = createOptimProblem('fmincon', ...
%     'objective', @(x) minimizeError(x, grpOriErr), ...
%     'x0', [rand(1, size(grpOriErr, 1)), rand, rand], ...              % initial guess
%     'lb', [zeros(1, size(grpOriErr, 1)), 0, 0], ...      % lower bounds
%     'ub', [], ...                                        % upper bounds
%     'nonlcon', nonlcon, ...  
%     'options', optimoptions('fmincon', ...
%         'Display','off', ...
%         'TolFun',1e-6, ...
%         'TolX',1e-6));
% 
% % GlobalSearch setup
% gs = GlobalSearch('Display','iter','NumTrialPoints',2000,'NumStageOnePoints',1000);
% 
% % Run GlobalSearch
% [optimalValues, fval] = run(gs, problem);
% 
% disp('Optimal parameters:');
% disp(optimalValues);
% disp('Final objective value:');
% disp(fval);
% 
% nLevels = size(grpOriErr, 1);
% sigma_e_arr = optimalValues(1:nLevels);
% sigma_i = optimalValues(nLevels + 1);
% shape = optimalValues(nLevels + 2);
% scale = 1/shape;
% analyticalStd = sqrt(sigma_e_arr.^2 + sigma_i^2*scale^2*shape*(shape+1));
% disp(analyticalStd)


function err = minimizeError(params, data)

nLevels = size(data, 1);
sigma_i = params(nLevels + 1);
varGain = params(nLevels + 2);
sigma_e_arr = params(1:nLevels);

ll = 0;
for i=1:nLevels
    sigma_e = params(i);
    x = data(i, :);
    p = myCustomPDF(x, sigma_e, sigma_i, varGain);
    p(p <= 0 | isnan(p)) = eps;
    ll = ll + sum(log(p)); % negative log likelihood
end

% Constraint
shape = 1/varGain;
scale = varGain;
analyticalStd = sqrt(sigma_e_arr.^2 + sigma_i^2*scale^2*shape*(shape+1));
targetStds = (std(data, 0, 2))';

assert(isequal(size(targetStds), size(analyticalStd)))

% sum of square error
err = -ll + sum( (analyticalStd - targetStds).^2 );

end

function p=myCustomPDF(x, sigma_e, sigma_i, varGain)

sampleCnt = 100;
shapeParam = 1./varGain;
scaleParam = varGain;
gammaSamples = gaminv(linspace(1/sampleCnt, 1 - 1/sampleCnt, sampleCnt), ...
    shapeParam, scaleParam);
sigma_theta = sqrt( sigma_e'.^2 + (sigma_i*gammaSamples).^2 );

p_X = exp(- (x').^2 ./ (2*sigma_theta.^2 ) ) ./ sqrt(2*pi*sigma_theta.^2);
p = sum(p_X, 2);

end

function [c, ceq] = var_constraint(p, x)

nLevels = size(x, 1);
sigma_i = p(nLevels + 1);
varGain = p(nLevels + 2);
sigma_e_arr = p(1:nLevels);

shape = 1/varGain;
scale = varGain;
analyticalStd = sqrt(sigma_e_arr.^2 + sigma_i^2*scale^2*shape*(shape+1));

% STD from data
targetStds = (std(x))';

% Equality constraint
tol = 1e-1;
ceq = abs(analyticalStd - targetStds) - tol; % All these equalities are enforced simultaneously

% No inequality constraints
c = [];

end


