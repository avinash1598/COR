% % mixturePDF = mixturePDF./trapz(x, mixturePDF);
% 
% % % Find Cc and sigma_m
% % options = optimset('Display', 'iter', 'TolFun', 1e-6, 'TolX', 1e-12);
% % targetResp.errHC = grpOriErrHC;
% % targetResp.errLC = grpOriErrLC;
